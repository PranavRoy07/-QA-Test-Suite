{
  "info": {
    "name": "DummyJSON - QA Suite",
    "description": "Postman/Newman collection mirroring the pytest API suite: products, users, and auth, with status-code and schema assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://dummyjson.com" }
  ],
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "Get all products",
          "request": { "method": "GET", "url": "{{baseUrl}}/products" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has products array', () => Array.isArray(pm.response.json().products));",
                  "pm.test('Array is not empty', () => pm.response.json().products.length > 0);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get single product",
          "request": { "method": "GET", "url": "{{baseUrl}}/products/1" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Has required fields', () => {",
                  "  ['id','title','price','description','category','rating','stock'].forEach(f => pm.expect(body).to.have.property(f));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get products by category",
          "request": { "method": "GET", "url": "{{baseUrl}}/products/category/smartphones" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('All items match category', () => {",
                  "  pm.response.json().products.forEach(item => pm.expect(item.category).to.eql('smartphones'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get nonexistent product (negative)",
          "request": { "method": "GET", "url": "{{baseUrl}}/products/999999" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users & Auth",
      "item": [
        {
          "name": "Get all users",
          "request": { "method": "GET", "url": "{{baseUrl}}/users" },
          "event": [
            {
              "listen": "test",
              "script": { "exec": [ "pm.test('Status code is 200', () => pm.response.to.have.status(200));" ] }
            }
          ]
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users/add",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"QA\",\n  \"lastName\": \"Tester\",\n  \"email\": \"qa.automation.test@example.com\",\n  \"username\": \"qa_auto_tester\",\n  \"password\": \"TestPass123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 or 201', () => pm.expect([200,201]).to.include(pm.response.code));",
                  "pm.test('Response has id', () => pm.expect(pm.response.json()).to.have.property('id'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - valid credentials",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"emilys\",\n  \"password\": \"emilyspass\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has accessToken', () => pm.expect(pm.response.json()).to.have.property('accessToken'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - invalid credentials (negative)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"not_a_real_user\",\n  \"password\": \"wrong_password\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rejected with 4xx', () => pm.expect(pm.response.code).to.be.oneOf([400,401,404]));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
